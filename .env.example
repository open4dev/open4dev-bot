# Telegram Bot
BOT_TOKEN=your_telegram_bot_token

# Minter Contract (deployed on TON)
MINTER_ADDRESS=EQxxxx...
COLLECTION_ADDRESS=EQxxxx...

# TON Connect (must be publicly accessible URL)
TON_CONNECT_MANIFEST_URL=https://raw.githubusercontent.com/open4dev/open4dev-bot/main/public/tonconnect-manifest.json

# Redis (optional - for persistent wallet connections)
# USE_REDIS=true
# REDIS_URL=redis://localhost:6379

# NFT Settings
DEFAULT_METADATA_URL=https://example.com/nft/open4dev.json
DEFAULT_PRICE=0.01
